# Application
APP_NAME=agentic-aiops-platform
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
APP_WORKERS=4

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://aiops:aiops_secret@localhost:5432/aiops_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aiops_knowledge
QDRANT_API_KEY=

# ========== LLM Provider Keys ==========
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=org-your-org-id
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_DIMS=3072

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Cohere (for embeddings)
COHERE_API_KEY=

# Ollama (self-hosted)
OLLAMA_BASE_URL=http://localhost:11434

# ========== Model Routing ==========
DEFAULT_CHAT_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
DEFAULT_INTENT_MODEL=gpt-4o-mini
DEFAULT_PLANNING_MODEL=gpt-4o
DEFAULT_TROUBLESHOOTING_MODEL=gpt-4o
DEFAULT_RAG_MODEL=gpt-4o
LLM_FALLBACK_ENABLED=true

# Authentication
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 / Azure AD
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_REDIRECT_URI=http://localhost:8000/auth/callback

# Okta
OKTA_DOMAIN=your-org.okta.com
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret

# ServiceNow
SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=changeme

# Jira
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=your-jira-token

# GitHub
GITHUB_TOKEN=ghp_your-github-token
GITHUB_ORG=your-org

# AWS
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# Kubernetes
KUBECONFIG_PATH=~/.kube/config
K8S_IN_CLUSTER=false

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-token
SLACK_SIGNING_SECRET=your-signing-secret

# Microsoft Teams
TEAMS_TENANT_ID=your-tenant-id
TEAMS_CLIENT_ID=your-client-id
TEAMS_CLIENT_SECRET=your-client-secret

# Email (SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=noreply@yourcompany.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@yourcompany.com

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentic-aiops
OTEL_ENVIRONMENT=development
PROMETHEUS_PORT=9090

# Security
ENCRYPTION_KEY=change-me-encryption-key-32-bytes!
RATE_LIMIT_PER_MINUTE=100
CORS_ORIGINS=["http://localhost:3000"]

# LLM Configuration
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75

# Policy Engine
AUTO_APPROVE_THRESHOLD=0.3
HIGH_RISK_THRESHOLD=0.7
CRITICAL_RISK_THRESHOLD=0.9
